using System;
using System.IO;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace ScriptableApp
{
    public partial class MainForm : Form
    {
        public static EventService EventService { get; private set; }
        private readonly ScriptingHost _scriptingHost;

        public MainForm()
        {
            InitializeComponent();
            
            EventService = new EventService(this);
            _scriptingHost = new ScriptingHost();

            // Привязка данных к ListBox (п. 5.3)
            listBoxEvents.DataSource = EventService.Events;

            // Запуск Named Pipes сервера в отдельном Task (п. 5.2.2)
            Task.Run(() => _scriptingHost.RunAsync());
        }

        // Кнопка выполнения скрипта из текстового поля (п. 5.1.6)
        private async void btnExecute_Click(object sender, EventArgs e)
        {
            string scriptCode = txtScriptInput.Text;
            if (!string.IsNullOrWhiteSpace(scriptCode))
            {
                btnExecute.Enabled = false;
                await _scriptingHost.ExecuteAsync(scriptCode);
                btnExecute.Enabled = true;
            }
        }

        // Выполнение скрипта из текстового файла (п. 5.5)
        private async void btnLoadFile_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog openFileDialog = new OpenFileDialog())
            {
                openFileDialog.Filter = "Текстовые файлы (*.txt)|*.txt|Файлы скриптов (*.csx)|*.csx|Все файлы (*.*)|*.*";
                if (openFileDialog.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        string fileContent = File.ReadAllText(openFileDialog.FileName);
                        txtScriptInput.Text = fileContent; // Отобразим в поле для наглядности
                        await _scriptingHost.ExecuteAsync(fileContent);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Не удалось прочитать файл: {ex.Message}", "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }

        // Ручное добавление события через интерфейс формы (п. 5.3)
        private void btnAddManual_Click(object sender, EventArgs e)
        {
            if (!string.IsNullOrWhiteSpace(txtTitle.Text))
            {
                EventService.Add(txtTitle.Text, txtDescription.Text, dateTimePicker.Value);
                txtTitle.Clear();
                txtDescription.Clear();
            }
        }

        // Ручное удаление события из интерфейса (п. 5.3)
