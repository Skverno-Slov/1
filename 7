3. Сервисный слой для управления событиями (EventService.cs)

Обеспечивает синхронизацию потоков (так как именованные каналы работают в фоновом потоке) и обновление UI.
csharp
using System;
using System.ComponentModel;
using System.Linq;

namespace ScriptableApp
{
    public class EventService
    {
        public BindingList<EventModel> Events { get; } = new BindingList<EventModel>();
        private int _nextId = 1;
        private readonly ISynchronizeInvoke _syncInvoke;

        public EventService(ISynchronizeInvoke syncInvoke)
        {
            _syncInvoke = syncInvoke;
        }

        public void Add(string title, string description, DateTime dateTime)
        {
            ExecuteOnUI(() =>
            {
                Events.Add(new EventModel
                {
                    Id = _nextId++,
                    Title = title,
                    Description = description,
                    DateTime = dateTime
                });
            });
        }

        public bool Delete(int id)
        {
            return (bool)ExecuteOnUI(() =>
            {
                var ev = Events.FirstOrDefault(e => e.Id == id);
                if (ev != null)
                {
                    Events.Remove(ev);
                    return true;
                }
                return false;
            });
        }

        public void Clear()
        {
            ExecuteOnUI(() => Events.Clear());
        }

        private object ExecuteOnUI(Delegate method)
        {
            if (_syncInvoke != null && _syncInvoke.InvokeRequired)
            {
                return _syncInvoke.Invoke(method, null);
            }
            return method.DynamicInvoke();
        }
    }
}
