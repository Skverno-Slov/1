                    txtScriptInput.Text = fileContent;
                    await _scriptingHost.ExecuteAsync(fileContent);
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Не удалось прочитать файл: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
                }
            }
        }

        // Ручное добавление через интерфейс
        private void btnAddManual_Click(object sender, RoutedEventArgs e)
        {
            if (!string.IsNullOrWhiteSpace(txtTitle.Text))
            {
                DateTime selectedDate = datePicker.SelectedDate ?? DateTime.Now;
                EventService.Add(txtTitle.Text, txtDescription.Text, selectedDate);
                txtTitle.Clear();
                txtDescription.Clear();
            }
        }

        // Ручное удаление через интерфейс
        private void btnDeleteManual_Click(object sender, RoutedEventArgs e)
        {
            if (listBoxEvents.SelectedItem is EventModel selectedEvent)
            {
                EventService.Delete(selectedEvent.Id);
            }
        }
    }
}
