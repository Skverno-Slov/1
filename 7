Шаг 3: Реализация тестового клиента (ScriptClient)

Код для консольного приложения, отправляющего скрипты через Named Pipe (пункт 5.2.3):
csharp
using System;
using System.IO;
using System.IO.Pipes;
using System.Text;

namespace ScriptClient
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("=== Клиент управления ПО через скрипты ===");
            Console.WriteLine("Введите команду для отправки или нажмите Enter для отправки тестового набора.");
            
            string input = Console.ReadLine();

            // Если пользователь ничего не ввел, отправляем тестовые CRUD команды
            if (string.IsNullOrWhiteSpace(input))
            {
                input = "CreateEvent(\"Встреча по проекту\", \"Обсуждение архитектуры скриптинга\", \"31.10.2026 15:00\");\n" +
                        "CreateEvent(\"Сдача лабы №7\", \"Показать рабочий именованный канал\", \"01.11.2026 10:00\");\n" +
                        "Message(\"События успешно импортированы через Named Pipes!\");";
            }

            try
            {
                using (var pipe = new NamedPipeClientStream(".", "mypipe", PipeDirection.Out))
                {
                    Console.WriteLine("Подключение к серверу приложений...");
                    pipe.Connect(5000); // Таймаут 5 секунд
                    
                    using (var writer = new StreamWriter(pipe, Encoding.UTF8))
                    {
                        writer.Write(input);
                        writer.Flush();
                        Console.WriteLine("Скрипт успешно передан серверу.");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"Ошибка подключения: {ex.Message}");
                Console.ResetColor();
            }

            Console.WriteLine("\nНажмите любую кнопку для выхода...");
            Console.ReadKey();
        }
    }
}
