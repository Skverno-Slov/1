4. Движок выполнения скриптов (ScriptingHost.cs)

Реализует компиляцию C# Scripting и сервер Named Pipes (пункты 5.1.4, 5.1.5, 5.2.1).
csharp
using System;
using System.IO;
using System.IO.Pipes;
using System.Text;
using System.Threading.Tasks;
using Microsoft.CodeAnalysis.CSharp.Scripting;
using Microsoft.CodeAnalysis.Scripting;

namespace ScriptableApp
{
    public class ScriptingHost
    {
        private ScriptOptions _scriptOptions; // п. 5.1.5

        public ScriptingHost()
        {
            // Инициализация опций скрипта (п. 5.1.5)
            _scriptOptions = ScriptOptions.Default
                .WithReferences(AppDomain.CurrentDomain.GetAssemblies())
                .WithImports("System", "System.Collections.Generic", "System.Linq");
        }

        // Выполнение кода скрипта (п. 5.1.4)
        public async Task ExecuteAsync(string code)
        {
            try
            {
                await CSharpScript.EvaluateAsync(code, _scriptOptions, new Automation());
            }
            catch (Exception ex)
            {
                System.Windows.Forms.MessageBox.Show($"Ошибка выполнения скрипта: {ex.Message}", "Ошибка", 
                    System.Windows.Forms.MessageBoxButtons.OK, System.Windows.Forms.MessageBoxIcon.Error);
            }
        }

        // Сервер именованного канала (п. 5.2.1)
        public async Task RunAsync()
        {
            while (true)
            {
                using (NamedPipeServerStream server = new NamedPipeServerStream("mypipe", PipeDirection.In, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous))
                {
                    await server.WaitForConnectionAsync();
                    await HandleClient(server);
                }
            }
        }

        // Обработка данных от клиента (п. 5.2.1)
        private async Task HandleClient(NamedPipeServerStream server)
        {
            using (var reader = new StreamReader(server, Encoding.UTF8))
            {
                string command = await reader.ReadToEndAsync();
                if (!string.IsNullOrWhiteSpace(command))
                {
                    // Выполняем полученную команду как скрипт
                    await ExecuteAsync(command);
                }
            }
        }
    }
}
