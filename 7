2. Сервис управления событиями (EventService.cs)

В WPF вместо BindingList стандартно используется ObservableCollection. Для безопасного изменения коллекции из фонового потока (в котором работает Named Pipes) используется Application.Current.Dispatcher.
csharp
using System;
using System.Collections.ObjectModel;
using System.Linq;
using System.Windows;

namespace WpfScriptableApp
{
    public class EventService
    {
        // Использование ObservableCollection для автоматического обновления UI в WPF
        public ObservableCollection<EventModel> Events { get; } = new ObservableCollection<EventModel>();
        private int _nextId = 1;

        public void Add(string title, string description, DateTime dateTime)
        {
            // Перенаправляем выполнение в поток UI
            Application.Current.Dispatcher.Invoke(() =>
            {
                Events.Add(new EventModel
                {
                    Id = _nextId++,
                    Title = title,
                    Description = description,
                    DateTime = dateTime
                });
            });
        }

        public bool Delete(int id)
        {
            return Application.Current.Dispatcher.Invoke(() =>
            {
                var ev = Events.FirstOrDefault(e => e.Id == id);
                if (ev != null)
                {
                    Events.Remove(ev);
                    return true;
                }
                return false;
            });
        }

        public void Clear()
        {
            Application.Current.Dispatcher.Invoke(() => Events.Clear());
        }
    }
}
